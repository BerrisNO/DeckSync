{
  "name": "decksync",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "validate": "streamdeck validate app.decksync.sdPlugin",
    "pack": "node build.mjs && streamdeck pack app.decksync.sdPlugin --output dist --force",
    "test": "esbuild test/run.ts --bundle --platform=node --format=esm --target=node20 --alias:@elgato/streamdeck=./test/fake.ts --outfile=test/out.mjs --log-level=error && node test/out.mjs",
    "images": "python -I tools/gen-images.py"
  },
  "dependencies": {
    "@elgato/streamdeck": "^3.0.1"
  },
  "devDependencies": {
    "@elgato/cli": "latest",
    "@types/node": "^26.6.4",
    "esbuild": "latest",
    "fflate": "^0.8.3",
    "typescript": "latest"
  }
}
